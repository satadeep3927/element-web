# StreamMint Environment Variables
# You can override these in Vercel's dashboard under Environment Variables

# Custom OpenGraph image for social media previews
RIOT_OG_IMAGE_URL=https://your-domain.vercel.app/themes/element/img/logos/opengraph.png

# CSP (Content Security Policy) extra source if needed
# CSP_EXTRA_SOURCE=https://your-domain.vercel.app